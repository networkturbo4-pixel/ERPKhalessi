<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Forzar HTTPS si está disponible
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Fallback directo a PHP para almacenamiento y SSE en cPanel
  RewriteRule ^api/storage/stream/?$ api/storage/stream.php [L,QSA]
  RewriteRule ^api/storage/?$ api/storage.php [L,QSA]
  RewriteRule ^api/storage/([^/]+)$ api/storage.php?key=$1 [L,QSA]

  # Servir archivos o directorios estáticos existentes directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirigir todas las demás rutas a index.html (SPA Fallback)
  RewriteRule ^ index.html [L]
</IfModule>

# Compresión Gzip / Deflate para carga ultra rápida
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Caché de activos estáticos
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# Nunca servir credenciales ni librerias internas
<FilesMatch "^(config\.local\.php|config\.php|storage-lib\.php)$">
  Require all denied
</FilesMatch>
